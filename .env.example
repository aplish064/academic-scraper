# Copy to .env and fill real API keys locally. .env is ignored by git.

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=academic_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Semicolon-separated email:key pairs, in rotation order.
# Multiple credentials: contact1@example.com:key1;contact2@example.com:key2
OPENALEX_CREDENTIALS=contact@example.com:replace_with_openalex_key
OPENALEX_ENABLE_ANONYMOUS_FALLBACK=1
OPENALEX_RESTART_HOUR=9

SEMANTIC_API_KEY=semantic_scholar_key

ORCID_CLIENT_ID=APP-xxxxxxxxxxxxxxxx
ORCID_CLIENT_SECRET=orcid_client_secret
ORCID_BASE_URL=https://pub.orcid.org/v3.0
ORCID_OAUTH_TOKEN_URL=https://orcid.org/oauth/token

CV_DATABASE=academic_cv
CV_BUILDER_ENV_FILE=
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_MAILTO=your_email@example.com
CROSSREF_USER_AGENT=Top-Talent-Academic/1.0
CV_BUILDER_REQUEST_TIMEOUT=30
